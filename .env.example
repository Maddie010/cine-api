# Conexión a la base de datos (valores por defecto de MySQL en Laragon)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cine_db

# Clave secreta para firmar los tokens JWT (extra de autenticación)
JWT_SECRET=cambia_este_secreto

# Puerto de la API (opcional, por defecto 3000)
PORT=3000
